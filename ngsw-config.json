{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "firebase-api",
      "urls": ["https://uteqgram-24428-default-rtdb.firebaseio.com/**"],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "1d",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "firebase-images",
      "urls": ["https://firebasestorage.googleapis.com/**"],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "5d",
        "strategy": "performance",
        "cacheOpaqueResponses": true
      }
    }
  ]
}
